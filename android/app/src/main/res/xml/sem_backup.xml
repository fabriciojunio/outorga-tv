<?xml version="1.0" encoding="utf-8"?>
<!-- Nada do app vai para backup nem para outro aparelho: o cookie de login
     é deste aparelho, e o endereço do PC de casa só vale nesta rede. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
