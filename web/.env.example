# Endereço da API do Outorga TV.
# Em desenvolvimento com o docker compose: http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Identificador do serviço que este site atende.
# É o slug do cliente cadastrado na plataforma. Trocar este valor é trocar de
# marca, de catálogo e de tabela de preços, sem mexer em uma linha de código.
NEXT_PUBLIC_SERVICO=cineserra

# Mostra a faixa de aviso de ambiente de demonstração no topo do site.
# Coloque false quando o serviço entrar em operação de verdade.
NEXT_PUBLIC_DEMONSTRACAO=true

# ---------- Modo "Em casa" (docs/CASA.md) ----------

# Token de leitura da API do TMDB (o "API Read Access Token", que começa com
# eyJ). Pegue em https://www.themoviedb.org/settings/api. Sem ele, /casa mostra
# o aviso de configuração e o resto do site segue igual.
TMDB_TOKEN=

# Pasta com os seus vídeos (mp4, mkv, webm, m4v, mov). Subpastas entram.
# Legenda .srt com o mesmo nome do vídeo é carregada sozinha.
# Exemplo no Windows: BIBLIOTECA_DIR=D:\Filmes
BIBLIOTECA_DIR=

# Onde fica o banco do acervo (SQLite). Padrão: web/.dados/casa.db
# CASA_BANCO=

# Liga e desliga o sincronizador que mantém o acervo atualizado. Padrão: ligado.
# CASA_SINCRONIZAR=false
